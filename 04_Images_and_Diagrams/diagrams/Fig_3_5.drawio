        <!-- ===== CNN ===== -->
        <mxCell id="cnn_box" value="1D-CNN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E65100;strokeWidth=2;fontSize=14;fontStyle=1;verticalAlign=top" vertex="1" parent="1">
