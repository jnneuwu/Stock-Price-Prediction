          <mxGeometry x="60" y="640" width="460" height="50" as="geometry" /></mxCell>
        <mxCell id="cnn_note" value="Detects local patterns (3-day motifs): ~30K params — smallest model" style="text;html=1;fontSize=9;fontStyle=2;align=center" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="460" height="30" as="geometry" /></mxCell>

        <!-- ===== RF ===== -->
        <mxCell id="rf_box" value="Random Forest (non-sequential baseline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B71C1C;strokeWidth=2;fontSize=14;fontStyle=1;verticalAlign=top" vertex="1" parent="1">
