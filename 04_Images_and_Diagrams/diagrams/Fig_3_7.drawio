<mxfile host="app.diagrams.net" version="22.0.0">
  <diagram name="Recursive Forecast" id="rec">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" pageWidth="1200" pageHeight="700">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t" value="Fig 3.7  Five-Day Recursive Forecast Mechanism" style="text;html=1;align=center;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="500" height="30" as="geometry" /></mxCell>
        <mxCell id="subt" value="Each day's prediction is fed back as the next day's input (autoregressive)" style="text;html=1;align=center;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="w0" value="Window₀&#10;Day N-19 ... N&#10;(20 days, 10 features)&#10;⟵ all real data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#0D47A1;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="150" height="80" as="geometry" /></mxCell>
        <mxCell id="m1" value="Model&#10;(LSTM/RNN/GRU/CNN/RF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="220" y="90" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="p1" value="pred₁&#10;close_norm&#10;for Day N+1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="390" y="90" width="130" height="60" as="geometry" /></mxCell>
        <mxCell id="mk1" value="Build new row:&#10; row[0] = pred₁&#10; row[1..9] = previous day's values&#10;Append → drop oldest&#10;→ Window₁ (shifted by 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=9;align=left" vertex="1" parent="1">
          <mxGeometry x="550" y="80" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="w1" value="Window₁&#10;Day N-18 ... N+1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#4527A0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="m2" value="Model" style="rounded=1;fillColor=#C8E6C9;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="220" y="210" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="p2" value="pred₂ (Day N+2)" style="rounded=1;fillColor=#FFCDD2;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="390" y="210" width="130" height="40" as="geometry" /></mxCell>
        <mxCell id="w2" value="Window₂" style="rounded=1;fillColor=#D1C4E9;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="550" y="210" width="130" height="40" as="geometry" /></mxCell>
        <mxCell id="dots" value="... repeat for days N+3, N+4, N+5 ..." style="text;html=1;fontSize=12;fontStyle=2;align=center" vertex="1" parent="1">
          <mxGeometry x="120" y="280" width="500" height="30" as="geometry" /></mxCell>
        <mxCell id="w5" value="Window₅&#10;Day N-14 ... N+5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#4A148C;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="out" value="Final output:&#10;[pred₁, pred₂, pred₃, pred₄, pred₅]&#10;= 5-day forecast for each model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#B71C1C;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="220" y="320" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="warn" value="⚠  Error accumulates:&#10;pred_t depends on pred_(t-1),&#10;so errors compound over 5 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;fontSize=10;align=left" vertex="1" parent="1">
          <mxGeometry x="550" y="320" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="mt" value="Note: Each model maintains ITS OWN window because predictions diverge.&#10;LSTM/RNN/GRU/CNN use torch.FloatTensor.unsqueeze(0) → shape (1, 20, 10).&#10;RF reshapes to (1, 200)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontSize=11;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="1080" height="80" as="geometry" /></mxCell>
        <mxCell id="save" value="Save to MySQL table &apos;model_forecasts&apos;:&#10;(ticker, day_ahead, forecast_date, actual, lstm_pred, rnn_pred, gru_pred, cnn_pred, rf_pred)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#4A148C;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1080" height="60" as="geometry" /></mxCell>
        <mxCell id="e1" style="endArrow=classicThin;strokeWidth=2" edge="1" parent="1" source="w0" target="m1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=classicThin;strokeWidth=2" edge="1" parent="1" source="m1" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=classicThin;strokeWidth=2" edge="1" parent="1" source="p1" target="mk1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="feedback" style="endArrow=classicThin;dashed=1;fontSize=9;strokeColor=#C62828" edge="1" parent="1" source="mk1" target="w1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="650" y="200" /><mxPoint x="115" y="200" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" style="endArrow=classicThin;strokeWidth=2" edge="1" parent="1" source="w1" target="m2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=classicThin;strokeWidth=2" edge="1" parent="1" source="m2" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="endArrow=classicThin;strokeWidth=2" edge="1" parent="1" source="p2" target="w2"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
