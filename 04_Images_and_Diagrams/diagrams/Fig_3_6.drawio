<mxfile host="app.diagrams.net" version="22.0.0">
  <diagram name="Training Flowchart" id="flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" pageWidth="900" pageHeight="1000">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t" value="Fig 3.6  Training Protocol with Early Stopping &amp; LR Scheduling" style="text;html=1;align=center;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="10" width="700" height="30" as="geometry" /></mxCell>
        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="380" y="50" width="100" height="40" as="geometry" /></mxCell>
        <mxCell id="init" value="Initialize model&#10;(random weights)&#10;Set best_val = ∞, counter = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9C4;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="320" y="110" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="epoch" value="For epoch = 1 to 150" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="320" y="190" width="220" height="40" as="geometry" /></mxCell>
        <mxCell id="train" value="Training phase:&#10;for each batch:&#10; • forward pass&#10; • loss = MSE(pred, y)&#10; • loss.backward()&#10; • clip_grad_norm_(params, 1.0)&#10; • optimizer.step()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=left" vertex="1" parent="1">
          <mxGeometry x="150" y="250" width="280" height="130" as="geometry" /></mxCell>
        <mxCell id="val" value="Validation phase:&#10; • model.eval()&#10; • with no_grad:&#10;   val_pred = model(X_val)&#10;   val_loss = MSE(val_pred, y_val)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=10;align=left" vertex="1" parent="1">
          <mxGeometry x="460" y="250" width="280" height="130" as="geometry" /></mxCell>
        <mxCell id="record" value="Record train_loss and val_loss&#10;(saved later to loss_history.json)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4C3;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="320" y="400" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="dec1" value="val_loss &lt; best_val ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="320" y="470" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="save" value="Save best weights&#10;best_val = val_loss&#10;counter = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A5D6A7;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="70" y="485" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="inc" value="counter += 1&#10;scheduler.step(val_loss)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFAB91;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="590" y="485" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="dec2" value="counter ≥ 20?&#10;(patience)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="590" y="560" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="stop" value="EARLY STOP&#10;Load best weights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="600" y="660" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="dec3" value="epoch &lt; 150?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFCDD2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="320" y="560" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="end" value="End (return best model)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="350" y="680" width="160" height="40" as="geometry" /></mxCell>
        <mxCell id="multi" value="Repeat 3 runs per model → keep best (lowest val_loss)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="740" width="460" height="40" as="geometry" /></mxCell>
        <mxCell id="e0" style="endArrow=classicThin" edge="1" parent="1" source="start" target="init"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" style="endArrow=classicThin" edge="1" parent="1" source="init" target="epoch"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=classicThin" edge="1" parent="1" source="epoch" target="train"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=classicThin" edge="1" parent="1" source="epoch" target="val"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=classicThin" edge="1" parent="1" source="train" target="record"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=classicThin" edge="1" parent="1" source="val" target="record"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=classicThin" edge="1" parent="1" source="record" target="dec1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="YES" style="endArrow=classicThin;fontSize=10" edge="1" parent="1" source="dec1" target="save"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="NO" style="endArrow=classicThin;fontSize=10" edge="1" parent="1" source="dec1" target="inc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="endArrow=classicThin" edge="1" parent="1" source="inc" target="dec2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="YES" style="endArrow=classicThin;fontSize=10" edge="1" parent="1" source="dec2" target="stop"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="NO" style="endArrow=classicThin;fontSize=10" edge="1" parent="1" source="dec2" target="dec3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="YES (next epoch)" style="endArrow=classicThin;fontSize=10" edge="1" parent="1" source="dec3" target="epoch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="260" y="595" /><mxPoint x="260" y="210" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" value="NO (done)" style="endArrow=classicThin;fontSize=10" edge="1" parent="1" source="dec3" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" style="endArrow=classicThin;dashed=1" edge="1" parent="1" source="save" target="dec3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="170" y="595" /></Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
